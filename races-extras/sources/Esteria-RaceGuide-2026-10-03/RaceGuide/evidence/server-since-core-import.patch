+    static void CollectJoinableBotArenaTeams(ArenaType type, TeamId faction, std::vector<ArenaTeam*>& out);
+    static void CreateBotArenaTeam(Player* bot, ArenaType type);
+    static bool IsBotArenaTeam(ArenaTeam const* team);
