+void Player::UpdatePvPState()
+{
+    UpdateFFAPvPState();
+
+    if (pvpInfo.IsHostile) // in hostile area
+    {
+        if (IsInFlight() || !m_taxi.empty()) // on taxi or taxi pending resume after login
+            return;
+
