+void PlayerbotFactory::ClearEverything()
+{
+    bot->GiveLevel(bot->getClass() == CLASS_DEATH_KNIGHT ? sWorld->getIntConfig(CONFIG_START_HEROIC_PLAYER_LEVEL)
+                                                         : sWorld->getIntConfig(CONFIG_START_PLAYER_LEVEL));
