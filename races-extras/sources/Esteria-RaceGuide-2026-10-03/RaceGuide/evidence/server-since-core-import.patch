+            continue;
+        }
+
+        spells.push_back(spellId);
+    }
+
+    for (std::list<uint32>::iterator i = spells.begin(); i != spells.end(); ++i)
+    {
+        bot->removeSpell(*i, SPEC_MASK_ALL, false);
