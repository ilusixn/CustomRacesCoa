    constexpr bool Uses(unsigned race)
    {
        return (race >= 54 && race <= 61) || race == 65 || race == 68 || race == 62 || race == 63 || race == 64
            || race == 66 || race == 69 || race == 70 || race == 73 || race == 74 || race == 75 || race == 76 || race == 77 || race == 78 || race == 79;
    }

    constexpr bool GenderAllowed(unsigned race, unsigned gender)
    {
        return Uses(race) && (gender == 0
            || ((race == 68 || race == 60 || race == 61 || race == 54 || race == 56 || race == 57 || race == 62 || race == 66 || race == 65 || race == 73 || race == 74 || race == 75 || race == 76 || race == 77 || race == 78 || race == 79) && gender == 1));
    }

    constexpr bool UsesPlayerVrykul(unsigned race, unsigned gender)
    {
        // These authored female models use ordinary DBC body/face materials rather than the native compositor.
        return (race == 56 || race == 57 || race == 66) && gender == 1;
    }

    constexpr std::array<Option, 5> const& Options(unsigned race, unsigned gender)
    {
        switch (race)
        {
            case 54:
                return gender ? NagaFemale : NagaMale;
            case 55:
                return TuskarrMale;
            case 56:
            case 57:
                return gender ? VrykulFemale : VrykulMale;
            case 58:
            case 59:
                return ThinhumanMale;
            case 60:
                return gender ? KyrianFemale : KyrianMale;
            case 61:
                return gender ? VenthyrFemale : VenthyrMale;
            case 62:
                return gender ? SethrakFemale : SethrakMale;
            case 65:
                return SlimeMale;
            case 73:
                return HozenMale;
            case 74:
                return VorkaiMale;
            case 75:
                return MantidMale;
            case 76:
                return EtherealMale;
            case 77:
                return BansheeMale;
            case 78:
                return FacelessMale;
            case 79:
                return gender ? QirajiFemale : QirajiMale;
            case 68:
                return gender ? CentaurFemale : CentaurMale;
            case 63:
                return GnollMale;
            case 64:
                return SaberonMale;
            case 66:
                return gender ? DrakkinFemale : DrakkinMale;
            case 69:
            case 70:
                return DrakonidMale;
            default:
                return NagaMale;
        }
    }

    constexpr bool Validate(unsigned race, unsigned gender, std::array<std::uint8_t, 5> const& fields)
    {
        if (!GenderAllowed(race, gender))
            return false;
        if (race == 69 || race == 70)
            return fields[0] < 17 && fields[1] < 4 && fields[2] < 6
                && fields[3] < 76 && fields[4] == 0;
        auto const& options = Options(race, gender);
        if (race >= 77 && race <= 79)
        {
            // pack races: the stock face / hair / facial-hair values are unused, only the skin (and Banshee hair) colour count
            for (unsigned i = 0; i < (race == 77 ? 2u : 1u); ++i)
                if (fields[i] >= options[i].count)
                    return false;
            return true;
        }
        for (unsigned i = 0; i < fields.size(); ++i)
            if (fields[i] >= options[i].count)
                return false;
        return true;
    }
}

#endif
