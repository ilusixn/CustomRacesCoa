diff --git a/src/d3d9/d3d9_interop.cpp b/src/d3d9/d3d9_interop.cpp
index 7594eb15..ff013bec 100644
--- a/src/d3d9/d3d9_interop.cpp
+++ b/src/d3d9/d3d9_interop.cpp
@@ -353,6 +353,145 @@ namespace dxvk {
     }
   }
 
+  // CoA64: image behind a D3D9 texture or surface, null for anything else
+  static Rc<DxvkImage> GetDxvkImage(IDirect3DResource9* pResource) {
+    switch (pResource->GetType()) {
+      case D3DRTYPE_SURFACE:       return static_cast<D3D9Surface*>     (pResource)->GetCommonTexture()->GetImage();
+      case D3DRTYPE_TEXTURE:       return static_cast<D3D9Texture2D*>   (pResource)->GetCommonTexture()->GetImage();
+      case D3DRTYPE_VOLUMETEXTURE: return static_cast<D3D9Texture3D*>   (pResource)->GetCommonTexture()->GetImage();
+      case D3DRTYPE_CUBETEXTURE:   return static_cast<D3D9TextureCube*> (pResource)->GetCommonTexture()->GetImage();
+      default:                     return nullptr;
+    }
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::RecordCallback(
+          PFN_D3D9VkRecordCallback  fn,
+          void*                     user,
+    const D3D9VkImageAccess*        images,
+          UINT                      count,
+    const void*                     userBlob,
+          UINT                      userBlobSize) {
+    if (unlikely(fn == nullptr || (count && images == nullptr) || (userBlobSize && userBlob == nullptr)))
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    std::vector<Rc<DxvkImage>> dxvkImages(count);
+    std::vector<D3D9VkImageAccess> access(images, images + count);
+
+    for (UINT i = 0u; i < count; i++) {
+      if (unlikely(access[i].pResource == nullptr))
+        return D3DERR_INVALIDCALL;
+
+      dxvkImages[i] = GetDxvkImage(access[i].pResource);
+
+      if (unlikely(dxvkImages[i] == nullptr))
+        return D3DERR_INVALIDCALL;
+    }
+
+    std::vector<uint8_t> blob;
+
+    if (userBlobSize) {
+      auto bytes = reinterpret_cast<const uint8_t*>(userBlob);
+      blob.assign(bytes, bytes + userBlobSize);
+    }
+
+    m_device->EmitCs([
+      cFn     = fn,
+      cUser   = user,
+      cImages = std::move(dxvkImages),
+      cAccess = std::move(access),
+      cBlob   = std::move(blob)
+    ] (DxvkContext* ctx) mutable {
+      // Ends the render pass and flushes all barriers. This also returns shared
+      // images to their default layout, so it must come before the transitions.
+      Rc<DxvkCommandList> cmdList = ctx->beginExternalRendering();
+
+      // Transition every image to the layout the callback needs (UNDEFINED: the
+      // image's default layout). Always goes through the barrier path so that
+      // pending clears are flushed and earlier accesses are synchronized.
+      for (size_t i = 0u; i < cImages.size(); i++) {
+        const auto& image = cImages[i];
+
+        VkImageLayout layout = cAccess[i].requiredLayout != VK_IMAGE_LAYOUT_UNDEFINED
+          ? cAccess[i].requiredLayout
+          : image->info().layout;
+
+        ctx->transformImage(image, image->getAvailableSubresources(),
+          VK_IMAGE_LAYOUT_MAX_ENUM, image->pickLayout(layout));
+      }
+
+      // Flush the transitions' barriers, without restoring shared images again
+      ctx->coaFlushBarriers();
+
+      for (size_t i = 0u; i < cImages.size(); i++) {
+        const auto& image = cImages[i];
+        const auto& info = image->info();
+
+        auto& a = cAccess[i];
+        a.layout = image->queryLayout(image->getAvailableSubresources());
+        a.image  = image->handle();
+        a.format = info.format;
+        a.extent = info.extent;
+        a.view   = VK_NULL_HANDLE;
+
+        VkImageUsageFlags usage = a.viewUsage ? a.viewUsage : VkImageUsageFlags(VK_IMAGE_USAGE_SAMPLED_BIT);
+
+        if ((info.usage & usage) != usage) {
+          Logger::warn(str::format("CoA: RecordCallback: image usage ", info.usage, " lacks view usage ", usage));
+          continue;
+        }
+
+        DxvkImageViewKey key;
+        key.viewType   = info.type == VK_IMAGE_TYPE_3D ? VK_IMAGE_VIEW_TYPE_3D : VK_IMAGE_VIEW_TYPE_2D;
+        key.usage      = usage;
+        key.format     = info.format;
+        key.layout     = a.layout;
+        key.aspects    = lookupFormatInfo(info.format)->aspectMask;
+        key.mipIndex   = 0u;
+        key.mipCount   = 1u;
+        key.layerIndex = 0u;
+        key.layerCount = 1u;
+
+        // Depth-only view of depth-stencil images unless used as an attachment
+        if ((key.aspects & VK_IMAGE_ASPECT_DEPTH_BIT) && !(usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT))
+          key.aspects &= ~VK_IMAGE_ASPECT_STENCIL_BIT;
+
+        // Views are cached by the image and live as long as it does
+        a.view = image->createView(key)->handle();
+      }
+
+      // Full memory barrier around the callback: earlier DXVK writes become visible
+      // to it, and its writes to everything DXVK records after it
+      VkMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+      barrier.srcStageMask  = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+      barrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+      barrier.dstStageMask  = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+      barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+
+      VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+      depInfo.memoryBarrierCount = 1u;
+      depInfo.pMemoryBarriers = &barrier;
+
+      cmdList->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+      VkCommandBuffer cmd = cmdList->getExecBuffer();
+      cFn(cmd, cAccess.data(), UINT(cAccess.size()), cBlob.empty() ? cUser : cBlob.data());
+
+      cmdList->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+      for (const auto& image : cImages)
+        cmdList->track(image, DxvkAccess::Write);
+
+      // The callback may have bound its own descriptors
+      cmdList->invalidateDescriptorHeapBinding();
+    });
+
+    return D3D_OK;
+  }
+
