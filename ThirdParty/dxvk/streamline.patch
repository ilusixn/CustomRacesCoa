@@ -0,0 +1,270 @@
+#include <algorithm>
+
+#include "dxvk_coa_streamline.h"
+#include "dxvk_instance.h"
+
+#include "../vulkan/vulkan_util.h"
+
+namespace dxvk::coa {
+
+  static std::mutex               g_mutex;
+  static bool                     g_hasRequirements = false;
+  static StreamlineRequirements   g_requirements;
+  static PFN_CoaVkDeviceCallback  g_deviceCallback = nullptr;
+  static PFN_CoaVkDeviceDestroyCallback g_destroyCallback = nullptr;
+  static std::atomic<PFN_vkQueuePresentKHR> g_presentProc = { nullptr };
+  static std::atomic<PFN_vkCreateSwapchainKHR>    g_createSwapchain = { nullptr };
+  static std::atomic<PFN_vkDestroySwapchainKHR>   g_destroySwapchain = { nullptr };
+  static std::atomic<PFN_vkGetSwapchainImagesKHR> g_getSwapchainImages = { nullptr };
+  static std::atomic<PFN_vkAcquireNextImageKHR>   g_acquireNextImage = { nullptr };
+  static std::atomic<PFN_vkDeviceWaitIdle>        g_deviceWaitIdle = { nullptr };
+  static std::atomic<PFN_vkCreateWin32SurfaceKHR> g_createWin32Surface = { nullptr };
+  static std::atomic<PFN_vkDestroySurfaceKHR>     g_destroySurface = { nullptr };
+  static std::atomic<PFN_CoaPresentMarker>        g_presentMarker = { nullptr };
+  static std::atomic<uint64_t>                    g_nextPresentFrame = { 0u };
+  // DXVK frame id -> client frame index, a small ring (presents in flight are few)
+  static std::atomic<uint64_t>                    g_boundDxvk[16];
+  static std::atomic<uint64_t>                    g_boundClient[16];
+
+
+  static std::vector<std::string> copyNames(const char* const* names, uint32_t count) {
+    std::vector<std::string> result;
+
+    for (uint32_t i = 0u; names && i < count; i++) {
+      if (names[i])
+        result.emplace_back(names[i]);
+    }
+
+    return result;
+  }
+
+
+  void setRequirements(const CoaVkRequirements* req) {
+    std::lock_guard lock(g_mutex);
+
+    g_hasRequirements = req != nullptr;
+    g_requirements = StreamlineRequirements();
+
+    if (!req)
+      return;
+
+    g_requirements.instanceExtensions = copyNames(req->instanceExtensions, req->instanceExtensionCount);
+    g_requirements.deviceExtensions   = copyNames(req->deviceExtensions,   req->deviceExtensionCount);
+    g_requirements.features12         = copyNames(req->features12,         req->features12Count);
+    g_requirements.features13         = copyNames(req->features13,         req->features13Count);
+    g_requirements.extraComputeQueues  = req->extraComputeQueues;
+    g_requirements.extraGraphicsQueues = req->extraGraphicsQueues;
+    g_requirements.opticalFlowQueues   = req->opticalFlowQueues;
+
+    Logger::info(str::format("CoA: Streamline requirements set: ",
+      g_requirements.instanceExtensions.size(), " instance extensions, ",
+      g_requirements.deviceExtensions.size(), " device extensions, ",
+      g_requirements.features12.size(), " + ", g_requirements.features13.size(), " features, ",
+      g_requirements.extraComputeQueues, " compute + ", g_requirements.extraGraphicsQueues, " graphics queues"));
+  }
+
+
+  void setDeviceCallback(PFN_CoaVkDeviceCallback cb) {
+    std::lock_guard lock(g_mutex);
+    g_deviceCallback = cb;
+  }
+
+
+  void setDeviceDestroyCallback(PFN_CoaVkDeviceDestroyCallback cb) {
+    std::lock_guard lock(g_mutex);
+    g_destroyCallback = cb;
+  }
+
+
+  void notifyDeviceDestroying(VkDevice device) {
+    PFN_CoaVkDeviceDestroyCallback cb = nullptr;
+
+    { std::lock_guard lock(g_mutex);
+      cb = g_destroyCallback;
+    }
+
+    if (cb)
+      cb(device);
+  }
+
+
+  void setSwapchainProcs(const CoaVkSwapchainProcs* procs) {
+    CoaVkSwapchainProcs p = procs ? *procs : CoaVkSwapchainProcs();
+    g_createSwapchain.store(p.createSwapchain, std::memory_order_release);
+    g_destroySwapchain.store(p.destroySwapchain, std::memory_order_release);
+    g_getSwapchainImages.store(p.getSwapchainImages, std::memory_order_release);
+    g_acquireNextImage.store(p.acquireNextImage, std::memory_order_release);
+    g_deviceWaitIdle.store(p.deviceWaitIdle, std::memory_order_release);
+    g_createWin32Surface.store(p.createWin32Surface, std::memory_order_release);
+    g_destroySurface.store(p.destroySurface, std::memory_order_release);
+    g_presentProc.store(p.queuePresent, std::memory_order_release);
+    Logger::info(str::format("CoA: swapchain procs ", procs ? "set" : "cleared"));
+  }
+
+
+  template<typename T>
+  static T pick(const std::atomic<T>& slot, T native) {
+    T proc = slot.load(std::memory_order_acquire);
+    return proc ? proc : native;
+  }
+
+
+  bool swapchainRouted() { return g_createSwapchain.load(std::memory_order_acquire) != nullptr; }
+
+  PFN_vkCreateSwapchainKHR    createSwapchain(PFN_vkCreateSwapchainKHR native)       { return pick(g_createSwapchain, native); }
+  PFN_vkDestroySwapchainKHR   destroySwapchain(PFN_vkDestroySwapchainKHR native)     { return pick(g_destroySwapchain, native); }
+  PFN_vkGetSwapchainImagesKHR getSwapchainImages(PFN_vkGetSwapchainImagesKHR native) { return pick(g_getSwapchainImages, native); }
+  PFN_vkAcquireNextImageKHR   acquireNextImage(PFN_vkAcquireNextImageKHR native)     { return pick(g_acquireNextImage, native); }
+  PFN_vkDeviceWaitIdle        deviceWaitIdle(PFN_vkDeviceWaitIdle native)            { return pick(g_deviceWaitIdle, native); }
+  PFN_vkCreateWin32SurfaceKHR createWin32Surface(PFN_vkCreateWin32SurfaceKHR native) { return pick(g_createWin32Surface, native); }
+  PFN_vkDestroySurfaceKHR     destroySurface(PFN_vkDestroySurfaceKHR native)         { return pick(g_destroySurface, native); }
+
+
+  void setNextPresentFrame(uint64_t frameIndex) {
+    g_nextPresentFrame.store(frameIndex, std::memory_order_release);
+  }
+
+
+  void bindPresentFrame(uint64_t dxvkFrameId) {
+    uint64_t client = g_nextPresentFrame.exchange(0u, std::memory_order_acq_rel);
+    uint32_t slot = uint32_t(dxvkFrameId % 16u);
+    g_boundClient[slot].store(client, std::memory_order_relaxed);
+    g_boundDxvk[slot].store(dxvkFrameId, std::memory_order_release);
+  }
+
+
+  void setPresentMarkerCallback(PFN_CoaPresentMarker cb) {
+    g_presentMarker.store(cb, std::memory_order_release);
+  }
+
+
+  void presentMarker(uint32_t marker, uint64_t dxvkFrameId) {
+    PFN_CoaPresentMarker cb = g_presentMarker.load(std::memory_order_acquire);
+    uint32_t slot = uint32_t(dxvkFrameId % 16u);
+
+    if (!cb || g_boundDxvk[slot].load(std::memory_order_acquire) != dxvkFrameId)
+      return;
+
+    uint64_t client = g_boundClient[slot].load(std::memory_order_relaxed);
+
+    if (client)
+      cb(marker, client);
+  }
+
+
+  void setPresentProc(PFN_vkQueuePresentKHR proc) {
+    g_presentProc.store(proc, std::memory_order_release);
+    Logger::info(str::format("CoA: present proc ", proc ? "set" : "cleared"));
+  }
+
+
+  VkResult queuePresent(
+          PFN_vkQueuePresentKHR native,
+          VkQueue               queue,
+    const VkPresentInfoKHR*     info) {
+    PFN_vkQueuePresentKHR proc = g_presentProc.load(std::memory_order_acquire);
+    return proc ? proc(queue, info) : native(queue, info);
+  }
+
+
+  std::optional<StreamlineRequirements> getRequirements() {
+    std::lock_guard lock(g_mutex);
+
+    if (!g_hasRequirements)
+      return std::nullopt;
+
+    return g_requirements;
+  }
+
+
+  void notifyDeviceCreated(const CoaVkDeviceInfo& info) {
+    PFN_CoaVkDeviceCallback cb = nullptr;
+
+    { std::lock_guard lock(g_mutex);
+      cb = g_deviceCallback;
+    }
+
+    if (cb)
+      cb(&info);
+  }
+
+
+  StreamlineExtensionProvider StreamlineExtensionProvider::s_instance;
+
+
+  std::string_view StreamlineExtensionProvider::getName() {
+    return "CoA Streamline";
+  }
+
+
+  DxvkExtensionList StreamlineExtensionProvider::getInstanceExtensions() {
+    std::lock_guard lock(m_mutex);
+    return m_instanceExtensions;
+  }
+
+
+  DxvkExtensionList StreamlineExtensionProvider::getDeviceExtensions(
+          uint32_t      adapterId) {
+    std::lock_guard lock(m_mutex);
+
+    if (adapterId < m_deviceExtensions.size())
+      return m_deviceExtensions[adapterId];
+
+    return DxvkExtensionList();
+  }
+
+
+  void StreamlineExtensionProvider::setRequirements(
+    const StreamlineRequirements& req) {
+    std::lock_guard lock(m_mutex);
+    m_requirements = req;
+  }
+
+
+  void StreamlineExtensionProvider::initInstanceExtensions() {
+    std::lock_guard lock(m_mutex);
+
+    m_instanceExtensions.clear();
+
+    for (const auto& name : m_requirements.instanceExtensions)
+      m_instanceExtensions.push_back(vk::makeExtension(name.c_str()));
+  }
+
+
+  void StreamlineExtensionProvider::initDeviceExtensions(
+    const DxvkInstance* instance) {
+    std::lock_guard lock(m_mutex);
+
+    const auto& names = m_requirements.deviceExtensions;
+    auto vki = instance->vki();
+
+    m_deviceExtensions.clear();
+
+    for (uint32_t i = 0u; instance->enumAdapters(i) != nullptr; i++) {
+      VkPhysicalDevice adapter = instance->enumAdapters(i)->handle();
+
+      uint32_t count = 0u;
+      vki->vkEnumerateDeviceExtensionProperties(adapter, nullptr, &count, nullptr);
+
+      std::vector<VkExtensionProperties> supported(count);
+      vki->vkEnumerateDeviceExtensionProperties(adapter, nullptr, &count, supported.data());
+
+      DxvkExtensionList list;
+
+      for (const auto& name : names) {
+        bool found = std::find_if(supported.begin(), supported.end(),
+          [&name] (const VkExtensionProperties& ext) {
+            return name == ext.extensionName;
+          }) != supported.end();
+
+        if (found)
+          list.push_back(vk::makeExtension(name.c_str()));
+        else
+          Logger::warn(str::format("CoA: Adapter ", i, " does not support device extension ", name, ", ignoring"));
+      }
+
+      m_deviceExtensions.push_back(std::move(list));
+    }
+  }
+
+}
diff --git a/src/dxvk/dxvk_coa_streamline.h b/src/dxvk/dxvk_coa_streamline.h
new file mode 100644
index 00000000..5cdca236
--- /dev/null
+++ b/src/dxvk/dxvk_coa_streamline.h
@@ -0,0 +1,207 @@
+#pragma once
+
+#include <atomic>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "dxvk_extension_provider.h"
+
+// CoA64: Streamline (NVIDIA DLSS) hooks. The client passes Streamline's Vulkan requirements through the exported
+// CoaDxvkSetVulkanRequirements before Direct3DCreate9 and gets the created device's handles back through the
+// CoaDxvkSetDeviceCallback callback. Nothing here changes DXVK's behaviour unless the requirements were set.
+// Each DxvkInstance latches the requirements once when it is created (Direct3DCreate9); later calls only affect
+// instances created after them.
+// Must match CoA64's ThirdParty/dxvk/include/coa_dxvk_streamline.h.
+
+struct CoaVkRequirements {
+  const char* const* instanceExtensions; uint32_t instanceExtensionCount;
+  const char* const* deviceExtensions;   uint32_t deviceExtensionCount;
+  const char* const* features12;         uint32_t features12Count;   // names as in VkPhysicalDeviceVulkan12Features
+  const char* const* features13;         uint32_t features13Count;   // names as in VkPhysicalDeviceVulkan13Features
+  uint32_t extraComputeQueues; uint32_t extraGraphicsQueues;
+  uint32_t opticalFlowQueues;                                       // VK_QUEUE_OPTICAL_FLOW_BIT_NV family
+};
+
+struct CoaVkDeviceInfo {
+  VkInstance instance; VkPhysicalDevice physicalDevice; VkDevice device;
+  uint32_t graphicsQueueFamily, graphicsQueueIndex;               // DXVK's own queue
+  uint32_t extraComputeQueueFamily, extraComputeQueueFirstIndex;   // first queue reserved for the app
+  uint32_t extraGraphicsQueueFamily, extraGraphicsQueueFirstIndex; // (0xFFFFFFFF: none reserved)
+  uint32_t opticalFlowQueueFamily, opticalFlowQueueIndex;
+};
+
+// Streamline's proxies for the calls it must see (sl_hooks.h, Vulkan); a null member keeps the driver's.
+struct CoaVkSwapchainProcs {
+  PFN_vkCreateSwapchainKHR    createSwapchain;
+  PFN_vkDestroySwapchainKHR   destroySwapchain;
+  PFN_vkGetSwapchainImagesKHR getSwapchainImages;
+  PFN_vkAcquireNextImageKHR   acquireNextImage;
+  PFN_vkQueuePresentKHR       queuePresent;
+  PFN_vkDeviceWaitIdle        deviceWaitIdle;
+  PFN_vkCreateWin32SurfaceKHR createWin32Surface;
+  PFN_vkDestroySurfaceKHR     destroySurface;
+};
+
+// Called on DXVK's queue thread around a present that carries a client frame (marker 0 start, 1 end).
+typedef void (__stdcall* PFN_CoaPresentMarker)(uint32_t marker, uint64_t frameIndex);
+
+typedef void (__stdcall* PFN_CoaVkDeviceCallback)(const CoaVkDeviceInfo* info);
+typedef void (__stdcall* PFN_CoaVkDeviceDestroyCallback)(VkDevice device);
+
+namespace dxvk::coa {
+
+  /**
+   * \brief Copy of the requirements passed by the client
+   */
+  struct StreamlineRequirements {
+    std::vector<std::string> instanceExtensions;
+    std::vector<std::string> deviceExtensions;
+    std::vector<std::string> features12;
+    std::vector<std::string> features13;
+    uint32_t extraComputeQueues  = 0u;
+    uint32_t extraGraphicsQueues = 0u;
+    uint32_t opticalFlowQueues   = 0u;
+  };
+
+  /**
+   * \brief Queues reserved for the client on device creation
+   */
+  struct StreamlineQueues {
+    uint32_t computeFamily      = VK_QUEUE_FAMILY_IGNORED;
+    uint32_t computeFirstIndex  = VK_QUEUE_FAMILY_IGNORED;
+    uint32_t graphicsFamily     = VK_QUEUE_FAMILY_IGNORED;
+    uint32_t graphicsFirstIndex = VK_QUEUE_FAMILY_IGNORED;
+    uint32_t opticalFlowFamily  = VK_QUEUE_FAMILY_IGNORED;
+    uint32_t opticalFlowIndex   = VK_QUEUE_FAMILY_IGNORED;
+  };
+
+  void setRequirements(const CoaVkRequirements* req);
+
+  void setDeviceCallback(PFN_CoaVkDeviceCallback cb);
+
+  void setDeviceDestroyCallback(PFN_CoaVkDeviceDestroyCallback cb);
+
+  /**
+   * \brief Sets Streamline's swapchain proxies (null clears all)
+   */
+  void setSwapchainProcs(const CoaVkSwapchainProcs* procs);
+
+  /**
+   * \brief Swapchains are created through Streamline (Frame Generation)
+   */
+  bool swapchainRouted();
+
+  PFN_vkCreateSwapchainKHR    createSwapchain(PFN_vkCreateSwapchainKHR native);
+  PFN_vkDestroySwapchainKHR   destroySwapchain(PFN_vkDestroySwapchainKHR native);
+  PFN_vkGetSwapchainImagesKHR getSwapchainImages(PFN_vkGetSwapchainImagesKHR native);
+  PFN_vkAcquireNextImageKHR   acquireNextImage(PFN_vkAcquireNextImageKHR native);
+  PFN_vkDeviceWaitIdle        deviceWaitIdle(PFN_vkDeviceWaitIdle native);
+  PFN_vkCreateWin32SurfaceKHR createWin32Surface(PFN_vkCreateWin32SurfaceKHR native);
+  PFN_vkDestroySurfaceKHR     destroySurface(PFN_vkDestroySurfaceKHR native);
+
+  /**
+   * \brief Client frame index for the next present (main thread)
+   */
+  void setNextPresentFrame(uint64_t frameIndex);
+
+  /**
+   * \brief Binds the pending client frame index to DXVK's frame id of this present
+   */
+  void bindPresentFrame(uint64_t dxvkFrameId);
+
+  void setPresentMarkerCallback(PFN_CoaPresentMarker cb);
+
+  /**
+   * \brief Present start (0) / end (1) for DXVK's frame id, if it carries a client frame
+   */
+  void presentMarker(uint32_t marker, uint64_t dxvkFrameId);
+
+  /**
+   * \brief Sets the present function the presenter calls instead of the driver's
+   *
+   * Streamline's vkQueuePresentKHR proxy (its presentCommon bookkeeping runs on
+   * every present). Null restores the driver's. The presenter calls it under
+   * the device queue lock, so a client that clears it and then takes and drops
+   * that lock (ID3D9VkInteropDevice::LockSubmissionQueue) knows no call into the
+   * old proc is still running.
+   */
+  void setPresentProc(PFN_vkQueuePresentKHR proc);
+
+  /**
+   * \brief Presents through the client's proc if one is set, else \c native
+   */
+  VkResult queuePresent(
+          PFN_vkQueuePresentKHR native,
+          VkQueue               queue,
+    const VkPresentInfoKHR*     info);
+
+  /**
+   * \brief Snapshot of the requirements
+   *
+   * Taken once per DxvkInstance on creation (see DxvkInstance::coaRequirements).
+   * \returns The requirements, or nothing if CoaDxvkSetVulkanRequirements was
+   *    not called (or called with null)
+   */
+  std::optional<StreamlineRequirements> getRequirements();
+
+  /**
+   * \brief Calls the device callback, if one was set
+   *
+   * Only called for instances that latched requirements.
+   */
+  void notifyDeviceCreated(const CoaVkDeviceInfo& info);
+
+  /**
+   * \brief Calls the destroy callback, if one was set
+   *
+   * From ~DxvkDevice once the device is idle, before the VkDevice goes,
+   * so a device whose D3D9 device never existed (failed InitialReset)
+   * is reported too. Only for instances that latched requirements.
+   */
+  void notifyDeviceDestroying(VkDevice device);
+
+  /**
+   * \brief Extension provider for the client's instance and device extensions
+   *
+   * Only registered with the instance when requirements were set. Extensions
+   * the driver does not support are logged and dropped.
+   */
+  class StreamlineExtensionProvider : public DxvkExtensionProvider {
+
+  public:
+
+    std::string_view getName();
+
+    DxvkExtensionList getInstanceExtensions();
+
+    DxvkExtensionList getDeviceExtensions(
+            uint32_t      adapterId);
+
+    void initInstanceExtensions();
+
+    void initDeviceExtensions(
+      const DxvkInstance* instance);
+
+    /**
+     * \brief Sets the requirements of the instance being created
+     *
+     * Called by DxvkInstance with its latched requirements
+     * before the extension sets are initialized.
+     */
+    void setRequirements(
+      const StreamlineRequirements& req);
+
+    static StreamlineExtensionProvider s_instance;
+
+  private:
+
+    std::mutex                      m_mutex;
+    StreamlineRequirements          m_requirements;
+    DxvkExtensionList               m_instanceExtensions;
+    std::vector<DxvkExtensionList>  m_deviceExtensions;
+
+  };
+
+}
