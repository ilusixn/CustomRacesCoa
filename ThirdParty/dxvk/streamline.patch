+/**
+ * \brief CoA64: image access for ID3D9VkInteropDevice1::RecordCallback
+ *
+ * In: resource, the layout the callback needs it in (UNDEFINED: the image's
+ * default DXVK layout) and the usage of the view to create (0: SAMPLED).
+ * Out (at callback time): image, view of mip 0 / layer 0 (null if the image
+ * lacks the usage), format, extent and the layout the image is actually in
+ * (DXVK may substitute GENERAL). The callback must leave it in that layout.
+ */
+struct D3D9VkImageAccess {
+  IDirect3DResource9* pResource; VkImageLayout requiredLayout; VkImageUsageFlags viewUsage;
+  VkImage image; VkImageView view; VkFormat format; VkExtent3D extent; VkImageLayout layout;
+};
+
+/**
+ * \brief CoA64: callback recording into DXVK's command buffer
+ *
+ * Called later on DXVK's CS thread, not inside RecordCallback. \c images is
+ * a copy of the array passed to RecordCallback with the out fields filled,
+ * \c user the copied user blob, or RecordCallback's \c user if no blob was
+ * given. \c images and the blob are only valid during the callback.
+ */
+typedef void (__stdcall* PFN_D3D9VkRecordCallback)(VkCommandBuffer cmd, D3D9VkImageAccess* images, UINT count, void* user);
+
+/**
+ * \brief CoA64: D3D9 device interop with command recording
+ */
+MIDL_INTERFACE("f9e3883a-e7ac-42ed-9a1d-d8f50e43aea9")
+ID3D9VkInteropDevice1 : public ID3D9VkInteropDevice {
+  /**
+   * \brief Records Vulkan commands into DXVK's command stream
+   *
+   * Emits a command to DXVK's CS thread that ends any render pass,
+   * transitions the images to their required layouts, flushes barriers
+   * and calls \c fn with DXVK's current command buffer, with a full
+   * memory barrier recorded before and after it. The images are then
+   * tracked as written. The callback runs later, not inside this call.
+   * \param [in] fn Callback
+   * \param [in] user Passed to the callback if \c userBlob is null
+   * \param [in] images Images the callback accesses
+   * \param [in] count Number of images
+   * \param [in] userBlob Data copied into the command and passed to the callback instead of \c user
+   * \param [in] userBlobSize Size of \c userBlob in bytes
+   * \returns D3D_OK, or D3DERR_INVALIDCALL for a null callback or an image-less resource
+   */
+  virtual HRESULT STDMETHODCALLTYPE RecordCallback(
+          PFN_D3D9VkRecordCallback  fn,
+          void*                     user,
+    const D3D9VkImageAccess*        images,
+          UINT                      count,
+    const void*                     userBlob,
+          UINT                      userBlobSize) = 0;
+};
+
