+
+    enableCoaFeatures(s_vk12, req.features12, m_featuresSupported.vk12, m_featuresEnabled.vk12, "Vulkan 1.2");
+    enableCoaFeatures(s_vk13, req.features13, m_featuresSupported.vk13, m_featuresEnabled.vk13, "Vulkan 1.3");
+
+    // Extra compute queues come from a dedicated compute family if the device has one,
+    // otherwise from DXVK's graphics family; extra graphics queues from the graphics family.
+    // Reserved queues always follow the ones DXVK itself uses in that family.
+    coa::StreamlineQueues result = { };
+
+    if (m_queueMapping.graphics.family == VK_QUEUE_FAMILY_IGNORED)
+      return result;
+
+    uint32_t computeFamily = findQueueFamily(
+      VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT,
+      VK_QUEUE_COMPUTE_BIT);
+
+    if (computeFamily == VK_QUEUE_FAMILY_IGNORED)
+      computeFamily = m_queueMapping.graphics.family;
+
+    auto reserve = [this] (uint32_t family, uint32_t count, uint32_t& outFamily, uint32_t& outIndex, const char* kind) {
+      if (!count)
+        return;
+
+      outFamily = family;
+
+      auto entry = std::find_if(m_queuesEnabled.begin(), m_queuesEnabled.end(),
+        [family] (const VkDeviceQueueCreateInfo& q) { return q.queueFamilyIndex == family; });
+
+      uint32_t used = entry != m_queuesEnabled.end() ? entry->queueCount : 0u;
+      uint32_t available = m_queuesAvailable[family].core.queueFamilyProperties.queueCount;
+
+      if (used + count > available) {
+        Logger::warn(str::format("CoA: Cannot reserve ", count, " ", kind, " queue(s) in family ", family,
+          " (", used, " used, ", available, " available), reserving none"));
+        return;
+      }
+
+      if (entry == m_queuesEnabled.end()) {
+        auto& q = m_queuesEnabled.emplace_back();
+        q.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+        q.queueFamilyIndex = family;
+        q.queueCount = count;
+      } else {
+        entry->queueCount = used + count;
+      }
+
+      outIndex = used;
+
+      Logger::info(str::format("CoA: Reserved ", count, " ", kind, " queue(s): family ", family, ", first index ", used));
+    };
+
+    reserve(computeFamily, req.extraComputeQueues,
+      result.computeFamily, result.computeFirstIndex, "compute");
+    reserve(m_queueMapping.graphics.family, req.extraGraphicsQueues,
+      result.graphicsFamily, result.graphicsFirstIndex, "graphics");
+
+    // Frame Generation's native optical flow needs a queue of its own family
+    if (req.opticalFlowQueues) {
+      uint32_t opticalFlowFamily = findQueueFamily(VK_QUEUE_OPTICAL_FLOW_BIT_NV, VK_QUEUE_OPTICAL_FLOW_BIT_NV);
+
+      if (opticalFlowFamily != VK_QUEUE_FAMILY_IGNORED)
+        reserve(opticalFlowFamily, req.opticalFlowQueues, result.opticalFlowFamily, result.opticalFlowIndex, "optical flow");
+      else
+        Logger::warn("CoA: No optical flow queue family");
+    }
+
+    // Fix up queue priority pointers for the new queue counts
+    uint32_t maxQueueCount = 0u;
+
+    for (auto& q : m_queuesEnabled)
+      maxQueueCount = std::max(maxQueueCount, q.queueCount);
+
+    m_queuePriorities.resize(maxQueueCount, 1.0f);
+
+    for (auto& q : m_queuesEnabled)
+      q.pQueuePriorities = m_queuePriorities.data();
+
+    return result;
+  }
